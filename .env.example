# Copy this file to .env and fill in an API key before running locally. Never commit .env or
# upload it in a submission ZIP -- the platform injects OPENAI_BASE_URL / OPENAI_API_KEY itself
# at run time (its own model proxy and a temporary credential).
#
# Defaults to the Kimi Coding Plan (https://www.kimi.com/code/docs/en/):
#   OPENAI_BASE_URL  https://api.kimi.com/coding/v1 (mainland China); accounts outside mainland
#                    China use https://api.kimi.ai/coding/v1
#   OPENAI_MODEL     k3
# Any other OpenAI-compatible /chat/completions endpoint works too.

OPENAI_BASE_URL=
OPENAI_MODEL=

# Required. KIMI_API_KEY is also accepted as an alternate name for the same value.
OPENAI_API_KEY=

# Optional advisory-stage controls. auto disables thinking only for deepseek-flash
# on api.deepseek.com; other providers retain their existing request shape.
PRO_MODEL_THINKING=auto
# PRO_MODEL_MAX_TOKENS=2000
# PRO_MODEL_REASONING_EFFORT=low

# Cost controls (per agent/card, not per eight-card batch). Unknown handover text
# always goes to the model. No-text weather uses the exact structured prompt rules.
PRO_MODEL_STRUCTURED_WEATHER=1
PRO_MODEL_MAX_RETRIES=2
# PRO_MODEL_MAX_CALLS=1500   # actual HTTP attempts, including retries
# PRO_MODEL_CACHE_SIZE=128  # identical-input replies only; no cross-date reuse
# PRO_MODEL_CALL_TIMEOUT=90
# PRO_MODEL_MAX_IN_FLIGHT=4
# Usage logs estimate official Flash charges conservatively at peak prices.
# Adjust these if the provider changes its rates; missing usage means unknown cost.
# PRO_MODEL_INPUT_CNY_PER_M=2
# PRO_MODEL_CACHED_CNY_PER_M=0.04
# PRO_MODEL_OUTPUT_CNY_PER_M=8
